# ============================================
# InterSci-KD 环境配置模板
# ============================================
# 使用方法：
#   1. 复制本文件为 .env  （命令：cp .env.example .env）
#   2. 在下方填入你自己的 API Key
#   3. 首次运行脚本时如检测到 Key 缺失，会交互式引导你输入
#
# 注意：.env 文件包含真实凭证，已被 .gitignore 排除，不会进入 git 仓库。
#       请勿手动 commit .env 文件，勿将真实 Key 贴到 issue 或聊天工具中。
# ============================================

# ---------- SCP 通用 API Key（必填，MCP 架构：单一 Key + 多端点） ----------
# 所有 11 个 SCP 数据工具（10 个 MCP 端点）共用此 Key，通过各工具独立端点调用
# 申请地址：https://scp.intern-ai.org.cn
SCP_HUB_API_KEY=

# ---------- SCP 网关配置（默认值通常无需改动） ----------
SCP_GATEWAY_URL=https://scp.intern-ai.org.cn/api/v1

# ---------- SCP 各 MCP 端点路径（默认值通常无需改动） ----------
# Sciverse: 学术文献检索
SCP_ENDPOINT_SCIVERSE=/mcp/43/Sciverse
# SciGraph-Material: 物质科学知识图谱
SCP_ENDPOINT_SCIGRAPH=/mcp/40/SciGraph-Material
# Origene-ChEMBL: 小分子药物数据库
SCP_ENDPOINT_CHEMBL=/mcp/4/Origene-ChEMBL
# Origene-PubChem: 化学信息数据库
SCP_ENDPOINT_PUBCHEM=/mcp/8/Origene-PubChem
# Origene-FDADrug: FDA 药品数据库
SCP_ENDPOINT_FDADRUG=/mcp/14/Origene-FDADrug
# Origene-OpenTargets: 靶点发现平台
SCP_ENDPOINT_OPENTARGETS=/mcp/15/Origene-OpenTargets
# Origene-TCGA: 癌症基因组图谱
SCP_ENDPOINT_TCGA=/mcp/11/Origene-TCGA
# Scholar-KG: 多学科论文检索
SCP_ENDPOINT_SCHOLAR=/mcp/42/Scholar-KG
# Origene-NCBI: 生物信息数据库
SCP_ENDPOINT_NCBI=/mcp/9/Origene-NCBI
# Origene-Search: 综合文献检索
SCP_ENDPOINT_SEARCH=/mcp/7/Origene-Search

# ---------- 书生大模型 API（可选，用于 LLM 后端生成报告） ----------
# 申请地址：https://intern-ai.org.cn
INTERNLM_API_KEY=
INTERNLM_BASE_URL=https://api.internlm.intern-ai.org.cn/v1
INTERNLM_MODEL=internlm3-latest

# ---------- 竞赛 API 配置（可选，仅赛事参与者需要） ----------
# API Key 由赛事方提供，请勿泄露
COMPETITION_API_KEY=
# API Base URL，不同 code agent 可能需要调整路径
COMPETITION_BASE_URL=https://fxb.supa.net.cn:6443/v1
# 模型名称: minimax-2.7 (推荐) | deepseek-v4-flash
COMPETITION_MODEL=minimax-2.7

# ---------- 模型参数（默认值通常无需改动） ----------
MAX_TOKENS=8192
TEMPERATURE=0.7
TIMEOUT=120

# ---------- 重试配置（默认值通常无需改动） ----------
MAX_RETRIES=3
RETRY_DELAY=5

# ---------- LLM 后端配置（可选） ----------
# 支持: internlm | openai | competition
LLM_BACKEND=competition

# OpenAI 兼容后端配置（当 LLM_BACKEND=openai 时生效）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
